prefix_rule(
    pattern = ["git","push","-u","origin","--mirror"],
    decision = "forbidden",
    justification = "Push only this run branch without force; main is changed through green PRs.",
    match = ["git push -u origin --mirror"],
    not_match = ["git push -u origin feature/x"],
)

prefix_rule(
    pattern = ["git","push","-u","origin","--all"],
    decision = "forbidden",
    justification = "Push only this run branch without force; main is changed through green PRs.",
    match = ["git push -u origin --all"],
    not_match = ["git push -u origin feature/x"],
)

prefix_rule(
    pattern = ["git","push","-u","origin","--delete"],
    decision = "forbidden",
    justification = "Push only this run branch without force; main is changed through green PRs.",
    match = ["git push -u origin --delete main"],
    not_match = ["git push -u origin feature/x"],
)

prefix_rule(
    pattern = ["git","push","origin","--delete"],
    decision = "forbidden",
    justification = "Push only this run branch without force; main is changed through green PRs.",
    match = ["git push origin --delete main"],
    not_match = ["git push -u origin chore/agents-retro"],
)

prefix_rule(
    pattern = ["git","push","-u","origin","main"],
    decision = "forbidden",
    justification = "Push only this run branch without force; main is changed through green PRs.",
    match = ["git push -u origin main"],
    not_match = ["git push -u origin feature/x"],
)

prefix_rule(
    pattern = ["git","push","-u","origin","HEAD:main"],
    decision = "forbidden",
    justification = "Push only this run branch without force; main is changed through green PRs.",
    match = ["git push -u origin HEAD:main"],
    not_match = ["git push -u origin feature/x"],
)

prefix_rule(
    pattern = ["git","push","-u","origin","+HEAD:main"],
    decision = "forbidden",
    justification = "Push only this run branch without force; main is changed through green PRs.",
    match = ["git push -u origin +HEAD:main"],
    not_match = ["git push -u origin feature/x"],
)

prefix_rule(
    pattern = ["git","push","-u","origin",":main"],
    decision = "forbidden",
    justification = "Push only this run branch without force; main is changed through green PRs.",
    match = ["git push -u origin :main"],
    not_match = ["git push -u origin feature/x"],
)

prefix_rule(
    pattern = ["git","worktree","remove","--force"],
    decision = "forbidden",
    justification = "Resolve why normal worktree removal failed; do not force it.",
    match = ["git worktree remove --force .claude/worktrees/gh133-panel"],
    not_match = ["git worktree remove .claude/worktrees/gh133-panel"],
)

prefix_rule(
    pattern = ["git","branch","-D","main"],
    decision = "forbidden",
    justification = "Delete only this run's local branch after merge.",
    match = ["git branch -D main"],
    not_match = ["git branch -D feature/gh133-panel"],
)

prefix_rule(
    pattern = ["git","branch","-D","master"],
    decision = "forbidden",
    justification = "Delete only this run's local branch after merge.",
    match = ["git branch -D master"],
    not_match = ["git branch -D feature/gh133-panel"],
)

prefix_rule(
    pattern = ["gh","pr","merge","--admin"],
    decision = "forbidden",
    justification = "Use the shared merge command after required CI checks.",
    match = ["gh pr merge --admin 42"],
    not_match = ["gh pr merge 42 --merge"],
)

prefix_rule(
    pattern = ["gh","pr","merge","--merge","--admin"],
    decision = "forbidden",
    justification = "Use the shared merge command after required CI checks.",
    match = ["gh pr merge --merge --admin 42"],
    not_match = ["gh pr merge 42 --merge"],
)
