prefix_rule(
    pattern = ["git","push","origin","--all"],
    decision = "forbidden",
    justification = "Push only this run branch without force; main is changed through green PRs.",
    match = ["git push origin --all"],
    not_match = ["git push -u origin chore/agents-retro"],
)

prefix_rule(
    pattern = ["git","push","-u","origin","--force"],
    decision = "forbidden",
    justification = "Push only this run branch without force; main is changed through green PRs.",
    match = ["git push -u origin --force feature/x"],
    not_match = ["git push -u origin feature/x"],
