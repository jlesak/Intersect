{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run typecheck*)",
      "Bash(npm run lint*)",
      "Bash(npm test*)",
      "Bash(npm run build)",
      "Bash(npm run e2e*)",
      "Bash(npm ci)",
      "Bash(npx vitest run *)",
      "Bash(npx eslint *)",
      "Bash(npx playwright show-trace *)",
      "Bash(npx -y lavish-axi *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue create *)",
      "Bash(gh issue edit *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr edit *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh run rerun *)",
      "Bash(gh label list *)",
      "Bash(gh api -X DELETE repos/jlesak/Intersect/git/refs/heads/chore/agents-retro)",
      "Bash(gh api -X DELETE repos/jlesak/Intersect/git/refs/heads/feature/gh*)",
      "Bash(gh api -X DELETE repos/jlesak/Intersect/git/refs/heads/fix/gh*)",
      "Bash(git fetch *)",
      "Bash(git worktree add *)",
      "Bash(git worktree list *)",
      "Bash(git worktree remove *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git branch -D feature/gh*)",
      "Bash(git branch -D fix/gh*)",
      "Bash(git branch -D chore/agents-retro)",
      "Bash(ln -s ../../../node_modules node_modules)"
    ],
    "deny": [
      "mcp__gitnexus",
      "Bash(gitnexus *)",
      "Bash(npx *gitnexus*)",
      "Bash(bunx *gitnexus*)",
      "Bash(pnpm *gitnexus*)",
      "Bash(node .gitnexus/*)",
      "Bash(prettier*)",
      "Bash(npx prettier*)",
      "Bash(npx -y prettier*)",
      "Bash(npx --yes prettier*)",
      "Bash(npm exec prettier*)",
      "Bash(git add -A*)",
      "Bash(git add * -A*)",
      "Bash(git add --all*)",
      "Bash(git add * --all*)",
      "Bash(git add .)",
      "Bash(git add * .)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push *--force*)",
      "Bash(git push * +*)",
      "Bash(git push * main)",
      "Bash(git push *:main*)",
      "Bash(git push *:refs/heads/main*)",
      "Bash(git push *--delete*)",
      "Bash(git push -d*)",
      "Bash(git push * -d *)",
      "Bash(git push * :*)",
      "Bash(git worktree remove *--force*)",
      "Bash(git worktree remove -f*)",
      "Bash(git worktree remove * -f*)",
      "Bash(gh pr merge *--admin*)"
    ]
  },
  "sandbox": {
    "excludedCommands": [
      "gh *",
      "npx -y lavish-axi *",
      "npm run e2e*",
      "npm test*",
      "npx vitest run *",
      "npm ci",
      "git worktree add *",
      "git worktree remove *",
      "git push *"
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": false
  },
  "skillOverrides": {
    "gitnexus-cli": "off",
    "gitnexus-debugging": "off",
    "gitnexus-exploring": "off",
    "gitnexus-guide": "off",
    "gitnexus-impact-analysis": "off",
    "gitnexus-lfg": "off",
    "gitnexus-pdg-query": "off",
    "gitnexus-plan": "off",
    "gitnexus-refactoring": "off",
    "gitnexus-review": "off",
    "gitnexus-taint-analysis": "off",
    "gitnexus-work": "off"
  }
}
